<Window x:Class="SteamWorkshopSynchronizer.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 Steam Workshop Synchronizer (SWS)"
        Width="500"
        SizeToContent="Height"
        MinHeight="360"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource GlassWindowBrush}"
        Foreground="{StaticResource GlassTextBrush}">
    <Border Margin="16" Padding="24" Background="{StaticResource GlassPanelBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Effect="{StaticResource GlassWindowShadow}">
        <StackPanel>
            <TextBlock Text="Steam Workshop Synchronizer (SWS)" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource GlassPrimaryBrush}" />
            <TextBlock Text="在玩家之间同步 Steam Workshop Mod 清单" Margin="0,8,0,22" Foreground="{StaticResource GlassMutedTextBrush}" TextWrapping="Wrap" />

            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="作者" FontWeight="SemiBold" Margin="0,0,0,9" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="DYS" Margin="0,0,0,9" />
                <TextBlock Grid.Row="1" Text="版本" FontWeight="SemiBold" Margin="0,0,0,9" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding VersionText}" Margin="0,0,0,9" />
                <TextBlock Grid.Row="2" Text="构建时间" FontWeight="SemiBold" Margin="0,0,0,9" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BuildTimeText}" Margin="0,0,0,9" />
                <TextBlock Grid.Row="3" Text="许可证" FontWeight="SemiBold" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="MIT License" />
            </Grid>

            <TextBlock Text="项目地址" FontWeight="SemiBold" />
            <TextBlock Margin="0,5,0,20" Foreground="{StaticResource GlassPrimaryBrush}" TextWrapping="Wrap" ToolTip="点击打开项目主页">
                <Hyperlink NavigateUri="https://github.com/DYS763/steam-workshop-synchronizer" RequestNavigate="ProjectLink_RequestNavigate">https://github.com/DYS763/steam-workshop-synchronizer</Hyperlink>
            </TextBlock>
            <TextBlock Text="Copyright © 2026 DYS" Foreground="{StaticResource GlassMutedTextBrush}" />
            <TextBlock Text="Licensed under the MIT License." Foreground="{StaticResource GlassMutedTextBrush}" />
            <Button Content="关闭" Width="92" HorizontalAlignment="Right" Margin="0,22,0,0" IsDefault="True" Click="Close_Click" ToolTip="关闭关于窗口" />
        </StackPanel>
    </Border>
</Window>
