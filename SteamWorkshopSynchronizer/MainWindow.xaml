<Window x:Class="SteamWorkshopSynchronizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SWS工坊同步器"
        Icon="pack://application:,,,/SteamWorkshopSynchronizer;component/Resources/SWS.ico"
        MinWidth="1100"
        MinHeight="680"
        Width="1280"
        Height="780"
        WindowStartupLocation="CenterScreen"
        Background="#DCECF2"
        Foreground="#173B50">
    <Window.Resources>
        <SolidColorBrush x:Key="GlassPanelBrush" Color="#BFFFFFFF" />
        <SolidColorBrush x:Key="GlassPanelStrongBrush" Color="#E8FFFFFF" />
        <SolidColorBrush x:Key="GlassBorderBrush" Color="#A3B7C6" />
        <SolidColorBrush x:Key="GlassHighlightBrush" Color="#F3FFFFFF" />
        <SolidColorBrush x:Key="ControlBrush" Color="#B8FFFFFF" />
        <SolidColorBrush x:Key="ControlHoverBrush" Color="#E8F4F6" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0B858D" />
        <SolidColorBrush x:Key="PrimaryLightBrush" Color="#D7F2EF" />
        <SolidColorBrush x:Key="TextBrush" Color="#173B50" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#506A7A" />
        <SolidColorBrush x:Key="TextSubtleBrush" Color="#6D8290" />
        <DropShadowEffect x:Key="GlassShadow" Color="#537082" BlurRadius="18" ShadowDepth="3" Opacity="0.2" />

        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource ControlBrush}" />
            <Setter Property="BorderBrush" Value="#9FB7C5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.015" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.015" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.975" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.975" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.015" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.015" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource ControlBrush}" />
            <Setter Property="BorderBrush" Value="#9FB7C5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="TextBoxBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="Menu">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Effect" Value="{StaticResource GlassShadow}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{StaticResource GlassPanelBrush}"
                                BorderBrush="{StaticResource GlassBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9">
                            <DockPanel>
                                <Border DockPanel.Dock="Top"
                                        Background="{StaticResource GlassPanelStrongBrush}"
                                        BorderBrush="{StaticResource GlassHighlightBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="14,11">
                                    <ContentPresenter ContentSource="Header" TextElement.Foreground="{TemplateBinding Foreground}" />
                                </Border>
                                <ContentPresenter Margin="13,12,13,13" />
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#BFE4F0F3" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#A9D6EFEC" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#6EABB3" />
                            </Trigger>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ItemBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.01" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="ItemBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.01" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ItemBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="ItemBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#66FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#9FB7C5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowBackground" Value="#65FFFFFF" />
            <Setter Property="AlternatingRowBackground" Value="#46E9F3F5" />
            <Setter Property="HorizontalGridLinesBrush" Value="#4CABC1C8" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserResizeRows" Value="False" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#CFE5F0F2" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="9,8" />
            <Setter Property="BorderBrush" Value="#9FB7C5" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="MinHeight" Value="35" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B8DCEEEF" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#B5BFE8E4" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
    </Window.Resources>

    <Border x:Name="RootShell"
            Margin="18"
            Background="#55FFFFFF"
            BorderBrush="#90FFFFFF"
            BorderThickness="1"
            CornerRadius="14"
            Padding="14"
            Effect="{StaticResource GlassShadow}"
            Opacity="0"
            RenderTransformOrigin="0.5,0.05">
        <Border.RenderTransform>
            <TranslateTransform Y="12" />
        </Border.RenderTransform>
        <DockPanel>
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource GlassPanelStrongBrush}"
                    BorderBrush="{StaticResource GlassBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="16"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="SWS" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                        <TextBlock Text="Steam Mod 清单同步工具" Margin="0,4,0,0" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="扫描" Width="88" Background="{StaticResource PrimaryLightBrush}" BorderBrush="{StaticResource PrimaryBrush}" Foreground="{StaticResource PrimaryBrush}" Click="RefreshScan_Click" ToolTip="重新读取 Steam 游戏、Workshop 和订阅状态" />
                        <Button Content="导入" Width="88" Background="{StaticResource PrimaryLightBrush}" BorderBrush="{StaticResource PrimaryBrush}" Foreground="{StaticResource PrimaryBrush}" Click="ImportFile_Click" ToolTip="从 JSON 或压缩文本文件导入 Mod 清单" />
                        <Menu VerticalAlignment="Center" ToolTip="打开导出、备份、日志和其他功能">
                            <MenuItem Header="更多" ToolTip="打开导出、备份、日志和其他功能">
                                <MenuItem Header="粘贴导入" Click="PasteImport_Click" ToolTip="从剪贴板导入 JSON 或压缩文本清单" />
                                <Separator />
                                <MenuItem Header="导出 JSON" Click="ExportJson_Click" ToolTip="将当前预设或订阅导出为 JSON 文件" />
                                <MenuItem Header="复制压缩文本" Click="CopyCompressed_Click" ToolTip="复制可通过聊天软件发送的压缩清单文本" />
                                <Separator />
                                <MenuItem Header="备份数据" Click="Backup_Click" ToolTip="备份预设、版本、回收站、历史和工具设置" />
                                <MenuItem Header="恢复数据" Click="Restore_Click" ToolTip="选择增量恢复或覆盖恢复工具数据" />
                                <Separator />
                                <MenuItem Header="复制失败清单" Click="CopyFailures_Click" ToolTip="复制订阅失败项目的名称、地址、ID 和原因" />
                                <MenuItem Header="导出失败清单" Click="ExportFailures_Click" ToolTip="将订阅失败项目保存为文本文件" />
                                <MenuItem Header="查看日志" Click="ViewLogs_Click" ToolTip="查看详细运行和错误日志" />
                                <MenuItem Header="关于" Click="About_Click" ToolTip="查看作者、版本、构建时间和许可证" />
                                <Separator />
                                <MenuItem x:Name="DeveloperModeMenuItem" Header="开发者模式" IsCheckable="True" Click="DeveloperMode_Click" ToolTip="开启后记录详细运行日志；错误和警告始终记录。" />
                            </MenuItem>
                        </Menu>
                    </StackPanel>
                    <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#70DDEEF0" CornerRadius="6" Padding="10,7" Margin="0,14,0,0">
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="状态  " FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                            <Run Text="{Binding StatusText, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" />
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <GroupBox Header="Steam 游戏">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="{StaticResource TextSubtleBrush}" Text="启动时自动扫描，也可点击顶部扫描。" TextWrapping="Wrap" />
                        <TextBox x:Name="GameSearchBox" DockPanel.Dock="Top" Margin="0,0,0,8" ToolTip="按游戏名称或 AppID 模糊搜索" TextChanged="GameSearchBox_TextChanged" />
                        <CheckBox x:Name="OnlyGamesWithModsCheckBox" DockPanel.Dock="Top" Content="只显示有 Mod 的游戏" Margin="0,0,0,8" Click="OnlyGamesWithMods_Click" ToolTip="隐藏没有扫描到 Workshop Mod 的游戏" />
                        <ListBox x:Name="GamesList" ItemsSource="{Binding Games}" SelectionChanged="GamesList_SelectionChanged" DisplayMemberPath="DisplayName" />
                    </DockPanel>
                </GroupBox>

                <GroupBox Grid.Column="1" Header="预设">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <Button Content="编辑" Click="EditPreset_Click" ToolTip="编辑当前预设并保存为新版本" />
                            <Button Content="版本" Click="PresetVersions_Click" Margin="0" ToolTip="查看、回滚或导出预设历史版本" />
                            <Button Content="回收站" Click="RecycleBin_Click" ToolTip="查看被工具取消订阅的 Mod 并重新订阅" />
                            <Button Content="操作历史" Click="History_Click" ToolTip="查看操作批次并撤回已提交请求" />
                            <Button Content="撤回最近批次" Click="UndoLatest_Click" Margin="0" ToolTip="快速撤回最近一次成功提交的批次" />
                        </WrapPanel>
                        <ListBox x:Name="PresetsList" ItemsSource="{Binding Presets}" SelectionChanged="PresetsList_SelectionChanged" ToolTip="选择预设以查看差异；点击右侧图标导出对应预设">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="1" Width="34" Height="30" Padding="0" Margin="8,0,0,0" Content="↥" FontSize="18" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Tag="{Binding}" Click="ExportPreset_Click" ToolTip="导出此预设为 JSON 文件" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </GroupBox>

                <GroupBox Grid.Column="2" Header="Mod 差异与状态" Margin="0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <WrapPanel>
                                <Button Content="全选" Click="SelectAll_Click" ToolTip="选择当前列表中的全部 Mod 项目" />
                                <Button Content="新建" Click="CreatePreset_Click" ToolTip="为当前游戏创建一个 Mod 预设" />
                                <Button Content="同步所选" Click="SyncSelected_Click" ToolTip="提交选中的订阅或取消订阅请求" />
                                <Button Content="切换忽略" Click="ToggleIgnore_Click" ToolTip="切换选中清单项的忽略状态并保存新版本" />
                                <Button Content="暂停" Click="PauseQueue_Click" ToolTip="暂停后续 Steam 请求" />
                                <Button Content="继续" Click="ResumeQueue_Click" ToolTip="继续提交暂停的 Steam 请求" />
                                <Button Content="停止后续" Click="StopQueue_Click" Margin="0" ToolTip="停止未开始的请求，已提交项目不受影响" />
                            </WrapPanel>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding SelectionSummary, Mode=OneWay}" Foreground="{StaticResource TextSubtleBrush}" />
                        </Grid>
                        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Text="先勾选需要执行的项目，再同步。Steam 处理后请重新扫描确认。" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" />
                        <Grid>
                            <Image Source="pack://application:,,,/SteamWorkshopSynchronizer;component/Resources/DYS.png"
                                   Width="190"
                                   Height="190"
                                   Margin="10"
                                   Opacity="0.22"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   IsHitTestVisible="False" />
                            <DataGrid x:Name="DiffGrid" ItemsSource="{Binding DiffRows}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Extended" CurrentCellChanged="DiffGrid_CurrentCellChanged" ContextMenuOpening="DiffGrid_ContextMenuOpening" Background="Transparent" RowBackground="#38FFFFFF" AlternatingRowBackground="#22FFFFFF">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="选择" Width="52">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          ClickMode="Press"
                                                          Focusable="False"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          ToolTip="点击选择或取消选择此项目" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="状态" Width="130" Binding="{Binding StatusText, Mode=OneWay}" IsReadOnly="True" />
                                    <DataGridTextColumn Header="动作" Width="100" Binding="{Binding ActionText, Mode=OneWay}" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Mod" Width="*" Binding="{Binding DisplayTitle, Mode=OneWay}" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Workshop ID" Width="125" Binding="{Binding PublishedFileId, Mode=OneWay}" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </DockPanel>
                </GroupBox>
            </Grid>
        </DockPanel>
    </Border>
</Window>
