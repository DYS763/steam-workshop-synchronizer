<Window x:Class="SteamWorkshopSynchronizer.PresetVersionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="预设版本"
        Width="760"
        Height="500"
        MinWidth="620"
        MinHeight="340"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="设为当前版本" Click="SetCurrent_Click" />
            <Button Content="导出选中版本" Click="ExportSelected_Click" />
            <Button Content="复制压缩文本" Click="CopyCompressed_Click" />
            <Button Content="关闭" IsCancel="True" Click="Close_Click" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Text="旧版本默认不参与普通导出；选择后可以设为当前或单独导出。" Foreground="#555" TextWrapping="Wrap" />
        <ListBox x:Name="VersionsList" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding VersionNumber, StringFormat=版本 {0}}" />
                        <TextBlock Grid.Column="1" Text="{Binding CreatedAt.LocalDateTime, StringFormat={}{0:g}}" />
                        <TextBlock Grid.Column="2" Text="{Binding CreatedReason}" />
                        <TextBlock Grid.Column="3" Text="{Binding Items.Count, StringFormat={}{0} 个 Mod}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
